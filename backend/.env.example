# 灵境 后端环境变量配置
# 复制此文件为 .env 并填入真实值

# Supabase (注册地址: https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
SUPABASE_ANON_KEY=eyJ...your-anon-key

# AI 服务（OpenAI 兼容接口）
# 用 DeepSeek：OPENAI_BASE_URL=https://api.deepseek.com 且 OPENAI_MODEL=deepseek-chat
# 注意 DeepSeek 没有 embeddings 接口，语义搜索需要保留 OpenAI 或换其他嵌入服务
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# JWT
JWT_SECRET=change-this-to-a-random-string

# 允许跨域的前端来源（逗号分隔，可加自己的 Vercel 域名）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://karyophilic.github.io
